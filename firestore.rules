rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function codigoConvite() {
      return get(/databases/$(db)/documents/config/app).data.convite;
    }
    // Código de convite e chaves secretas: ninguém lê pelo app
    match /config/{doc} { allow read, write: if false; }
    match /secrets/{doc} { allow read, write: if false; }
    // Chave pública das notificações
    match /public/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Dados de cada usuário: só o próprio usuário
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.convite == codigoConvite();
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.convite == resource.data.convite
                    && resource.data.bloqueado != true;
      allow delete: if false;
      match /{col}/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid
                           && exists(/databases/$(db)/documents/users/$(uid))
                           && get(/databases/$(db)/documents/users/$(uid)).data.bloqueado != true;
      }
    }
  }
}
